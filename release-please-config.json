{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "bab827f66de0ca2ac7997411924300e6cad172a0",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "pdx-ws",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "extra-files": [
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "docs/guide/github-action.md" },
        { "type": "generic", "path": "docs/guide/self-hosted-client-mode.md" },
        { "type": "generic", "path": "docs/examples/preview-pull-request.yml" },
        { "type": "generic", "path": "docs/examples/publish-on-release.yml" },
        { "type": "generic", "path": "docs/examples/release-please-monorepo.yml" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "revert", "section": "Reverts" },
        { "type": "build", "section": "Build" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "refactor", "section": "Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true }
      ]
    }
  }
}
